# =========================
# 1️⃣ Базовый образ
# =========================
FROM python:3.11-slim


# =========================
# 2️⃣ Установка системных зависимостей
# =========================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*


# =========================
# 3️⃣ Рабочая директория
# =========================
WORKDIR /app


# =========================
# 4️⃣ Копируем только файлы зависимостей для кэширования слоёв
# =========================
COPY pyproject.toml uv.lock ./


# =========================
# 5️⃣ Установка uv и зависимостей
# =========================
RUN pip install --no-cache-dir uv \
    && uv venv \
    && uv pip install --no-cache-dir -e ".[dev]"


# =========================
# 6️⃣ Копируем весь проект
# =========================
COPY . .


# =========================
# 7️⃣ Переменные окружения для Flask
# =========================
ENV FLASK_APP=main
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_ENV=production


# =========================
# 8️⃣ Порт приложения
# =========================
EXPOSE 8080


# =========================
# 9️⃣ Команда по умолчанию
# Flask app (runtime)
# =========================
CMD ["uv", "run", "flask", "run", "--port", "8080"]